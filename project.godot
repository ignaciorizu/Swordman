AudioManager="*uid://dvw2ysds5ylbr"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://src/": "orange",
"res://src/core/": "red",
"res://src/scenes/": "yellow",
"res://src/sprites/": "green"
}

